// Declarative Jenkins pipeline
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Retrieve source code from the configured Git repository
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                // Confirm the Jenkins build environment
                sh 'whoami'
                sh 'pwd'
                sh 'git --version'
            }
        }

        stage('Security Validation') {
            steps {
                // Scan the existing Docker image for HIGH and CRITICAL vulnerabilities.
               // Exit code 1 makes Jenkins fail when matching vulnerabilities are found.
               sh 'trivy image --severity HIGH,CRITICAL --exit-code 1 --scanners vuln devsecops-webapp:v1'
            }
        }
    }
}

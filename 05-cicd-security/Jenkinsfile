// DevSecOps Jenkins CI/CD Pipeline
// Purpose: Checkout source code, analyze code quality,
// build a Docker image, and scan for vulnerabilities.

pipeline {
    agent any

    stages {

        // Stage 1: Retrieve source code from GitHub
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Stage 2: Verify the Jenkins build environment
        stage('Environment Check') {
            steps {
                sh 'whoami'
                sh 'pwd'
                sh 'git --version'
                sh 'docker --version'
                sh 'trivy --version'
            }
        }

        // Stage 3: Analyze source code using SonarQube Cloud
        stage('SonarQube Analysis') {
            steps {
                script {
                    // Locate the scanner configured in Jenkins Tools
                    def scannerHome = tool 'SonarQubeScanner'

                    // Load SonarQube server settings and authentication
                    withSonarQubeEnv('SonarQubeCloud') {

                        // Run source code analysis
                        sh """
                            "${scannerHome}/bin/sonar-scanner" \\
                            -Dsonar.projectKey=Kuchambigit_devsecops-bootcamp \\
                            -Dsonar.organization=kuchambigit \\
                            -Dsonar.sources=. \\
                            -Dsonar.host.url=https://sonarcloud.io
                        """
                    }
                }
            }
        }

        // Stage 4: Build the Docker application image
        stage('Docker Build') {
            steps {
                // Build the image using the existing Dockerfile
                sh 'docker build --pull -t devsecops-webapp:ci ./04-docker-automation/webapp'
            }
        }

        // Stage 5: Scan the Docker image for vulnerabilities
        stage('Security Validation') {
            steps {
                // Fail the pipeline if HIGH or CRITICAL vulnerabilities are found
                sh 'trivy image --severity HIGH,CRITICAL --exit-code 1 --scanners vuln devsecops-webapp:ci'
            }
        }
    }

    post {
        success {
            // Display a message when every stage succeeds
            echo 'SUCCESS: SonarQube analysis, Docker build, and Trivy security scanning completed.'
        }

        failure {
            // Display a message if any stage fails
            echo 'FAILED: Check the Jenkins console output for errors.'
        }
    }
}
